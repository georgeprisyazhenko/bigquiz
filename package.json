    "images": "node scripts/fetch-images.js && node scripts/optimize-images.js",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "sharp": "^0.35.2",
    "vite": "^8.0.12",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "phaser": "^4.1.0"
  }
}
