{
  "name": "bigquiz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint --fix src/ scripts/",
    "format": "prettier --write src/ scripts/ public/ tests/",
